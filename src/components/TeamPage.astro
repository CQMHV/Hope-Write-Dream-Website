---
import BaseLayout from "@layouts/BaseLayout.astro";
import { localeMeta, translations, type Locale } from "@data/site";
import { siteConfig } from "@data/site-config.mjs";

type Props = {
    locale: Locale;
};

const { locale } = Astro.props;
const t = translations[locale];
---

<BaseLayout locale={locale} title={t.title} description={t.description} ogLocale={localeMeta[locale].ogLocale}>
    <main>
        <h1>{siteConfig.name}</h1>
        <p>{t.description}</p>
    </main>
</BaseLayout>
