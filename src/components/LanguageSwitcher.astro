---
import { localeMeta, locales, getLocaleUrl, type Locale } from "@data/site";

type Props = {
    locale: Locale;
};

const { locale } = Astro.props;
const currentLocale = localeMeta[locale];
---

<div class="language-switcher menu-control">
    <button class="small round secondary" type="button" aria-label="Language" aria-haspopup="menu">
        <i aria-hidden="true">translate</i>
        <span>{currentLocale.shortLabel}</span>
        <i aria-hidden="true">arrow_drop_down</i>
    </button>
    <menu class="right no-wrap" aria-label="Language">
        {
            locales.map((item) => (
                <li class:list={[item === locale && "active"]}>
                    <a
                        href={getLocaleUrl(item)}
                        lang={localeMeta[item].lang}
                        aria-current={item === locale ? "page" : undefined}
                    >
                        <span>{localeMeta[item].label}</span>
                    </a>
                </li>
            ))
        }
    </menu>
</div>
