---
import { localeMeta, locales, getLocaleUrl, socialLinks, type Locale } from "@data/site";

type Props = {
    locale: Locale;
    brand: string;
    social: {
        heading: string;
        body: string;
    };
    footer: {
        copyright: string;
        builtWith: string;
    };
};

const { locale, brand, social, footer } = Astro.props;
---

<footer id="social" class="site-footer page-section" aria-labelledby="social-title">
    <div>
        <h2 id="social-title">{social.heading}</h2>
        <p>{social.body}</p>
    </div>
    <div class="social-grid">
        {
            socialLinks.map((link) => (
                <a class="button secondary social-link" href={link.href} target="_blank" rel="noopener noreferrer">
                    <i aria-hidden="true">{link.icon}</i>
                    <span>{link.label}</span>
                </a>
            ))
        }
    </div>
    <div class="footer-bottom">
        <span>{footer.copyright}</span>
        <span>{footer.builtWith}</span>
        <nav aria-label={`${brand} languages`}>
            {
                locales.map((item) => (
                    <a href={getLocaleUrl(item)} lang={localeMeta[item].lang} aria-current={item === locale ? "page" : undefined}>
                        {localeMeta[item].label}
                    </a>
                ))
            }
        </nav>
    </div>
</footer>
