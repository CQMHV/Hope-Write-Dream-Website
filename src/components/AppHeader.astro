---
import { getRelativeLocaleUrl } from "astro:i18n";
import { localeMeta, locales, type Locale, type Translation } from "@/data/site";
import { defaultThemeMode } from "@/data/ui-preferences";
import { siteConfig } from "@/data/site.config.mjs";

type NavItem = {
    href: string;
    label: string;
    icon: string;
};

type Props = {
    locale: Locale;
    translation: Translation;
    navItems: NavItem[];
};

const { locale, translation: t, navItems } = Astro.props;
const themeOptions = [
    {
        value: "system",
        label: t.controls.system,
        icon: "contrast"
    },
    {
        value: "light",
        label: t.controls.light,
        icon: "light_mode"
    },
    {
        value: "dark",
        label: t.controls.dark,
        icon: "dark_mode"
    }
];
---

<header class="team-header fixed transparent small-blur">
    <nav class="responsive">
        <a class="team-brand no-wave" href="/" aria-label={siteConfig.name}>
            <img
                class="team-brand-logo team-brand-logo-light"
                src="/images/hopewritedream-logo-light.webp"
                alt=""
                aria-hidden="true"
            />
            <img
                class="team-brand-logo team-brand-logo-dark"
                src="/images/hopewritedream-logo-dark.webp"
                alt=""
                aria-hidden="true"
            />
            <span>{siteConfig.name}</span>
        </a>
        <div class="max"></div>
        {navItems.map((item) => (
            <a class="button transparent round m l" href={item.href}>{item.label}</a>
        ))}
        <div class="team-menu-wrap">
            <button class="circle primary-container" type="button" aria-label={t.controls.language} aria-haspopup="menu" aria-controls="language-menu" data-ui="#language-menu">
                <i>translate</i>
            </button>
            <menu class="left no-wrap" id="language-menu" aria-label={t.controls.language}>
                {locales.map((item) => (
                    <li
                        data-language={item}
                        data-ui-locale={localeMeta[item].lang}
                        data-route={getRelativeLocaleUrl(item, "")}
                        class:list={[{ active: item === locale }]}
                        aria-selected={item === locale ? "true" : "false"}
                    >
                        <a href={getRelativeLocaleUrl(item, "")}>
                            {localeMeta[item].label}
                        </a>
                    </li>
                ))}
            </menu>
        </div>
        <div class="team-menu-wrap">
            <button class="circle primary-container" type="button" aria-label={t.controls.theme} aria-haspopup="menu" aria-controls="theme-menu" data-ui="#theme-menu">
                <i>contrast</i>
            </button>
            <menu class="left no-wrap" id="theme-menu" aria-label={t.controls.theme}>
                {themeOptions.map((item) => (
                    <li
                        data-theme-mode-value={item.value}
                        class:list={[{ active: item.value === defaultThemeMode }]}
                        aria-selected={item.value === defaultThemeMode ? "true" : "false"}
                    >
                        <i>{item.icon}</i>
                        <span>{item.label}</span>
                    </li>
                ))}
            </menu>
        </div>
        <a
            class="button circle primary-container"
            href={siteConfig.repositoryUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
        >
            <svg class="small" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.59 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49v-1.9c-2.78.62-3.37-1.22-3.37-1.22-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.86.09-.66.35-1.12.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.97c.85 0 1.7.12 2.5.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.07.36.32.68.95.68 1.92v2.84c0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.25C22 6.59 17.52 2 12 2Z"></path>
            </svg>
        </a>
    </nav>
</header>
