---
type Member = {
    name: string;
    role: string;
    description: string;
    skills: string[];
};

type Props = {
    heading: string;
    body: string;
    items: Member[];
};

const { heading, body, items } = Astro.props;
---

<section id="members" class="page-section stacked-section" aria-labelledby="members-title">
    <div class="section-heading">
        <h2 id="members-title">{heading}</h2>
        <p>{body}</p>
    </div>
    <div class="member-grid">
        {
            items.map((member, index) => (
                <article class="member-card round large-padding">
                    <div class:list={["avatar-shape", `avatar-shape--${index + 1}`]} aria-hidden="true">
                        {member.name.slice(0, 1)}
                    </div>
                    <div>
                        <h3>{member.name}</h3>
                        <p class="role">{member.role}</p>
                        <p>{member.description}</p>
                    </div>
                    <div class="skill-row" aria-label={`${member.name} skills`}>
                        {member.skills.map((skill) => <span class="chip small">{skill}</span>)}
                    </div>
                </article>
            ))
        }
    </div>
</section>
